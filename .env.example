# Supabase — samma projekt som Usha Platform, så kontot och biblioteket delas.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Behövs bara för admin-uppslaget i åtkomstgrinden (profiles.is_admin).
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Vem som får använda appen:
#   tomt      = bara fulla admins
#   uuid,uuid = de kontona, plus admins
#   *         = alla som kan logga in med ett Usha-konto
LISTEN_ALLOWED_USER_IDS=
